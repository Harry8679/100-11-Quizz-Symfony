{% extends 'base.html.twig' %}

{% block title %}Question {{ numero }} / {{ total }}{% endblock %}

{% block body %}

{# ── En-tête : numéro + barre de progression ───────────────────────── #}
<div class="mb-8">

    <div class="flex items-center justify-between text-sm text-gray-500 mb-3">
        <span>Question {{ numero }} / {{ total }}</span>
        <span>{{ progress }}%</span>
    </div>

    {# Barre de progression : la largeur est calculée par PHP dans le controller #}
    <div class="w-full bg-gray-800 rounded-full h-2">
        <div class="bg-white h-2 rounded-full transition-all duration-500"
             style="width: {{ progress }}%">
        </div>
    </div>

</div>

{# ── La question ──────────────────────────────────────────────────────── #}
<div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 mb-6">
    <h2 class="text-xl font-bold text-white leading-relaxed">
        {{ question.question }}
    </h2>
</div>

{# ── Les choix de réponse ─────────────────────────────────────────────── #}
{# Formulaire POST vers app_quiz_repondre
   Chaque bouton soumet le formulaire avec la valeur de son input radio #}
<form method="POST" action="{{ path('app_quiz_repondre') }}">

    <div class="flex flex-col gap-3 mb-8">
        {% for choix in question.choix %}
            <label class="flex items-center gap-4 bg-gray-900 border border-gray-800
                          rounded-xl px-5 py-4 cursor-pointer hover:border-gray-600
                          hover:bg-gray-800 transition-colors group">

                {# input radio caché — on soumet en cliquant sur le label #}
                <input
                    type="radio"
                    name="reponse"
                    value="{{ choix }}"
                    required
                    class="w-4 h-4 accent-white"
                >
                <span class="text-gray-200 text-sm font-medium">{{ choix }}</span>

            </label>
        {% endfor %}
    </div>

    <button type="submit"
            class="w-full bg-white text-gray-900 font-bold py-4 rounded-xl
                   hover:bg-gray-100 transition-colors text-sm">
        Valider la réponse →
    </button>

</form>

{% endblock %}